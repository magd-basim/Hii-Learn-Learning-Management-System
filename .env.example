# Application
APP_NAME=Hii Learn – Learning Management System
APP_ENV=development
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg://db_user:your_password_here@localhost:5432/hii_learn_db
TEST_DATABASE_URL=postgresql+psycopg://db_user:your_password_here@localhost:5432/hii_learn_test_db

# Security & JWT
SECRET_KEY=replace_with_a_long_random_secret_key
ALGORITHM=HS256

# Token Expiration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30

# Frontend
FRONTEND_URL=http://localhost:5173